# Copy to .env.local (or run `pnpm env:local` after `supabase start` to generate it).
# Local Supabase values come from `pnpm exec supabase status`. Never commit real secrets.

# Browser-safe
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show the "Continue with Google" button (also enable [auth.external.google] in supabase/config.toml)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server / scripts only — direct Postgres connection (bypasses RLS).
# Used by `pnpm seed:exercises` and `pnpm test:db`, never by user requests.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Only needed if you enable Google sign-in locally (read by supabase/config.toml).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
